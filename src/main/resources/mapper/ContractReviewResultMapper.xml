    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, contract_id, risk_level, risk_score, total_risks, high_risks, medium_risks, low_risks, conclusion, report_url, matching_count, modified_count, missing_count, added_count, created_time, updated_time
